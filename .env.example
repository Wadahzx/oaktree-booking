PORT=3000
ADMIN_CODE=Fathima

# Database path (optional - defaults to ./data/oaktree.db)
# On Render with persistent disk, set to: /var/data/oaktree.db
DB_PATH=

# Uploads directory (optional - defaults to ./public/uploads)
# On Render with persistent disk, set to: /var/data/uploads
UPLOADS_DIR=

# SMTP Email Settings (optional - emails log to console if not configured)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@oaktree.com
SMTP_PASS=your-password
SMTP_FROM=noreply@oaktree.com
