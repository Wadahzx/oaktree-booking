# Supabase PostgreSQL connection string
# Get this from: Supabase → Project Settings → Database → Connection string → URI (Transaction Pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Resend email API key
RESEND_API_KEY=re_xxxxxxxxxxxx

# Admin login code - choose a strong one (used to sign admin sessions as well)
ADMIN_CODE=change-me

# Optional: secret used to sign admin session tokens (defaults to a value derived from ADMIN_CODE)
# SESSION_SECRET=

# Optional: public site URL, used for the logo in emails
# APP_URL=https://your-site.vercel.app

# Timezone
TZ=Asia/Riyadh

# Sender address for emails (must be a domain verified in Resend)
# RESEND_FROM=Oaktree Rooms <rooms@your-domain.com>

# Optional: secret protecting /api/cron/reminders (Vercel sends it automatically as a Bearer token)
# CRON_SECRET=

# Optional: restrict booking to these email domains (comma separated)
# ALLOWED_EMAIL_DOMAINS=oaktree.sa
